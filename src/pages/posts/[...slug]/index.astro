---
import { getCollection } from "astro:content";

import Head from "~/components/Head.astro";
import PostTags from "~/components/PostTags.astro";
import RelatedPosts from "~/components/RelatedPosts.astro";
import TableOfContents from "~/components/TableOfContents.astro";
import { SITE_TITLE } from "~/constants";
import { SITE } from "~/config/seo";
import Document from "~/layouts/Document.astro";
import { calculateWordCount, filterPosts } from "~/utils/content";
import { findRelatedPosts } from "~/utils/seo";

import "~/styles/markdown.css";

import type { CollectionEntry } from "astro:content";

// biome-ignore lint/nursery/useExplicitType: Inferred return type
export async function getStaticPaths() {
	const posts = await getCollection("posts", filterPosts({ archived: true }));

	return posts.map((props) => ({
		params: { slug: props.slug },
		props: { ...props, allPosts: posts },
	}));
}

export type Props = CollectionEntry<"posts"> & {
	allPosts: CollectionEntry<"posts">[];
};

const { render: renderPost, data: post, body, slug, allPosts } = Astro.props;
const { Content, headings } = await renderPost();

const wordCount = calculateWordCount(body);

// Find related posts based on shared tags
const currentPost = { slug, data: post } as CollectionEntry<"posts">;
const relatedPosts = findRelatedPosts(currentPost, allPosts, 3);

// Build article data for SEO
const articleData = {
	...post,
	slug,
	tags: post.tags ?? [],
	wordCount,
};

// Breadcrumbs for structured data
const breadcrumbs = [
	{ name: "Home", url: SITE.url },
	{ name: post.title, url: `${SITE.url}/posts/${slug}` },
];

// Build Head props, conditionally including optional fields
const headProps = {
	title: `${post.title} ─ ${SITE_TITLE}`,
	description: post.description,
	publishedAt: post.publishedAt.toISOString(),
	image: new URL(`/posts/${slug}/og.png`, Astro.site).href,
	type: "article" as const,
	article: articleData,
	breadcrumbs,
	...(post.lastModifiedAt && { modifiedAt: post.lastModifiedAt.toISOString() }),
	...(post.tags && post.tags.length > 0 && { keywords: post.tags }),
};
---

<Head {...headProps} />

<Document>
	<main class="flex-1">
		<article class="mx-auto max-w-letter px-5 py-12">
			<h1
				class="font-display text-4xl font-medium leading-tight tracking-tight text-ink sm:text-5xl"
			>
				{post.title}
			</h1>

			{
				post.canonicalUrl && (
					<a
						href={post.canonicalUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="mt-6 inline-flex items-center gap-2 rounded-md border border-ink px-4 py-2 font-sans text-sm text-ink transition-colors hover:bg-ink hover:text-paper"
					>
						Read the original ↗
					</a>
				)
			}

			<blockquote class="mt-10 border-l-2 border-ink pl-5">
				<p
					class="font-display text-2xl font-medium italic leading-snug text-ink"
				>
					{post.description}
				</p>
			</blockquote>

			<TableOfContents headings={headings} />

			<section class="prose mt-10 max-w-none">
				<Content />
			</section>

			{
				post.tags && post.tags.length > 0 && (
					<div class="mt-8">
						<PostTags tags={post.tags} />
					</div>
				)
			}

			{relatedPosts.length > 0 && <RelatedPosts posts={relatedPosts} />}
		</article>
	</main>
</Document>
