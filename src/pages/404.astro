---
import Head from "~/components/Head.astro";
import Document from "~/layouts/Document.astro";

const helpfulLinks = [
  { href: "/", title: "Directory", description: "Browse every entry" },
  { href: "/tags", title: "Topics", description: "Entries grouped by subject" },
  { href: "/projects", title: "Projects", description: "Things I've built" },
  {
    href: "/internet",
    title: "Internet",
    description: "Links and resources I've found",
  },
];
---

<Head
  title="Page Not Found"
  description="The page you're looking for doesn't exist. Explore our posts, projects, or return to the homepage."
  robots="noindex, follow"
/>

<Document>
  <main class="flex-1">
    <article class="mx-auto max-w-letter px-5 py-12">
      <div class="font-sans text-[11px] uppercase tracking-[0.2em] text-faint">
        An error · 404
      </div>
      <h1
        class="mt-5 font-display text-4xl font-medium leading-tight tracking-tight text-ink sm:text-5xl"
      >
        Page not found
      </h1>
      <p class="mt-4 text-[15px] leading-relaxed text-muted">
        This entry doesn't exist in the directory. Try one of these instead.
      </p>

      <section class="mt-10">
        <h2 class="font-sans text-xs uppercase tracking-[0.15em] text-faint">
          Helpful links
        </h2>
        <div class="mt-3 divide-y divide-line border-y border-line">
          {
            helpfulLinks.map((link) => (
              <a
                href={link.href}
                class="group flex items-center gap-4 px-4 py-3 transition-colors hover:bg-paper-hover"
              >
                <span class="flex min-w-0 flex-1 flex-col">
                  <span class="font-display text-[16px] font-medium leading-snug tracking-tight text-ink decoration-line underline-offset-4 group-hover:underline">
                    {link.title}
                  </span>
                  <span class="mt-0.5 font-sans text-[11px] text-faint">
                    {link.description}
                  </span>
                </span>
                <span
                  aria-hidden="true"
                  class="shrink-0 font-sans text-[11px] text-faint transition-colors group-hover:text-ink"
                >
                  →
                </span>
              </a>
            ))
          }
        </div>
      </section>

      <div class="mt-12 border-t border-line pt-6">
        <a
          class="font-sans text-sm text-muted underline decoration-line underline-offset-4 transition-colors hover:text-ink hover:decoration-ink"
          href="/"
        >
          ← Back to the directory
        </a>
      </div>
    </article>
  </main>
</Document>
