---
import { getCollection } from "astro:content";
import { format } from "date-fns";

import { Directory, type DirectoryPost } from "~/components/Directory";
import Head from "~/components/Head.astro";
import Document from "~/layouts/Document.astro";
import {
  calculateReadingTime,
  filterPosts,
  formatReadingTime,
  sortPostsByFeatured,
} from "~/utils/content";

const posts = await getCollection("posts").then((posts) =>
  posts
    .filter(filterPosts({ archived: false }))
    .sort(sortPostsByFeatured)
    .map(
      (post): DirectoryPost => ({
        slug: post.slug,
        href: `/posts/${post.slug}`,
        title: post.data.title,
        description: post.data.description,
        tags: post.data.tags,
        publishedAt: format(post.data.publishedAt, "yyyy-MM-dd"),
        image: post.data.image,
        readingTime: formatReadingTime(calculateReadingTime(post.body)),
      }),
    ),
);
---

<Head />

<Document>
  <main id="main-content" class="flex-1" tabindex="-1">
    <h1 class="sr-only">
      Ezz Abuzaid — writing on software and other experiments
    </h1>
    <Directory client:load posts={posts} />
  </main>
</Document>
