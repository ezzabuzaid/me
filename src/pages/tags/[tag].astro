---
import { getCollection } from "astro:content";

import Head from "~/components/Head.astro";
import PostRow from "~/components/PostRow.astro";
import Document from "~/layouts/Document.astro";
import { SITE } from "~/config/seo";
import { filterPosts, sortPostsByPublishedAt } from "~/utils/content";
import {
  extractAllTags,
  generateCollectionPageSchema,
  generateTagSlug,
} from "~/utils/seo";

import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async () => {
  const posts = await getCollection("posts", filterPosts({ archived: false }));
  const tagCounts = extractAllTags(posts);

  return Array.from(tagCounts.entries()).map(([tag, count]) => {
    const slug = generateTagSlug(tag);
    const displayName =
      posts
        .flatMap((p) => p.data.tags || [])
        .find((t) => t.toLowerCase() === tag) || tag;

    const tagPosts = posts
      .filter((p) => (p.data.tags || []).some((t) => t.toLowerCase() === tag))
      .sort(sortPostsByPublishedAt);

    return {
      params: { tag: slug },
      props: {
        tag: displayName,
        tagSlug: slug,
        posts: tagPosts,
        count,
      },
    };
  });
}) satisfies GetStaticPaths;

interface Props {
  tag: string;
  tagSlug: string;
  posts: Awaited<ReturnType<typeof getCollection<"posts">>>;
  count: number;
}

const { tag, tagSlug, posts, count } = Astro.props;

const pageTitle = `${tag} Articles`;
const pageDescription = `Browse ${count} article${count === 1 ? "" : "s"} about ${tag}. Tutorials, guides, and practical examples for developers.`;
const canonicalUrl = `${SITE.url}/tags/${tagSlug}`;

const breadcrumbs = [
  { name: "Home", url: SITE.url },
  { name: "Topics", url: `${SITE.url}/tags` },
  { name: tag, url: canonicalUrl },
];

const collectionSchema = generateCollectionPageSchema({
  name: pageTitle,
  description: pageDescription,
  url: canonicalUrl,
  itemCount: count,
});

const allPosts = await getCollection("posts", filterPosts({ archived: false }));
const allTagCounts = extractAllTags(allPosts);
const relatedTags = Array.from(allTagCounts.entries())
  .filter(([t]) => t !== tag.toLowerCase())
  .sort((a, b) => b[1] - a[1])
  .slice(0, 6)
  .map(([t, c]) => ({
    slug: generateTagSlug(t),
    count: c,
    displayName:
      allPosts
        .flatMap((p) => p.data.tags || [])
        .find((pt) => pt.toLowerCase() === t) || t,
  }));
---

<Head
  title={pageTitle}
  description={pageDescription}
  type="website"
  breadcrumbs={breadcrumbs}
  keywords={[tag, "tutorial", "guide", "web development"]}
/>

<Document>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(collectionSchema)}
  />
  <main class="flex-1">
    <article class="mx-auto max-w-letter px-5 py-12">
      <a
        class="font-sans text-[13px] text-muted underline decoration-line underline-offset-4 transition-colors hover:text-ink hover:decoration-ink"
        href="/tags"
      >
        ← All topics
      </a>

      <div class="mt-8 font-sans text-[11px] uppercase tracking-[0.2em] text-faint">
        A topic · {count}
        {count === 1 ? "entry" : "entries"}
      </div>
      <h1
        class="mt-5 font-display text-4xl font-medium capitalize leading-tight tracking-tight text-ink sm:text-5xl"
      >
        {tag}
      </h1>

      <div class="mt-10 divide-y divide-line border-y border-line">
        {
          posts.map((post) => (
            <PostRow
              href={`/posts/${post.slug}`}
              title={post.data.title}
              year={post.data.publishedAt.getFullYear()}
              kicker={post.data.tags[0]}
              description={post.data.description}
            />
          ))
        }
      </div>

      {
        relatedTags.length > 0 && (
          <section class="mt-10">
            <h2 class="font-sans text-xs uppercase tracking-[0.15em] text-faint">
              Browse more topics
            </h2>
            <div class="mt-3 flex flex-wrap gap-2">
              {relatedTags.map(({ displayName, slug, count }) => (
                <a
                  href={`/tags/${slug}`}
                  class="inline-flex items-center gap-2 rounded border border-line bg-paper px-3 py-1.5 font-sans text-[12px] text-muted transition-colors hover:border-faint hover:text-ink"
                >
                  <span>#{displayName}</span>
                  <span class="tabular text-faint">{count}</span>
                </a>
              ))}
            </div>
          </section>
        )
      }

      <div class="mt-12 border-t border-line pt-6">
        <a
          class="font-sans text-sm text-muted underline decoration-line underline-offset-4 transition-colors hover:text-ink hover:decoration-ink"
          href="/"
        >
          ← Back to the directory
        </a>
      </div>
    </article>
  </main>
</Document>
