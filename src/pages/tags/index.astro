---
import { getCollection } from "astro:content";

import Head from "~/components/Head.astro";
import Document from "~/layouts/Document.astro";
import { PAGE_SEO, SITE } from "~/config/seo";
import { filterPosts } from "~/utils/content";
import { extractAllTags, generateTagSlug } from "~/utils/seo";

const posts = await getCollection("posts", filterPosts({ archived: false }));
const tagCounts = extractAllTags(posts);

const sortedTags = Array.from(tagCounts.entries())
  .sort((a, b) => {
    if (b[1] !== a[1]) return b[1] - a[1];
    return a[0].localeCompare(b[0]);
  })
  .map(([tag, count]) => ({
    slug: generateTagSlug(tag),
    count,
    displayName:
      posts
        .flatMap((p) => p.data.tags || [])
        .find((t) => t.toLowerCase() === tag) || tag,
  }));

const breadcrumbs = [
  { name: "Home", url: SITE.url },
  { name: "Topics", url: `${SITE.url}/tags` },
];
---

<Head
  title={PAGE_SEO.tags.title}
  description={PAGE_SEO.tags.description}
  type="website"
  breadcrumbs={breadcrumbs}
/>

<Document>
  <main class="flex-1">
    <article class="mx-auto max-w-letter px-5 py-12">
      <a
        class="font-sans text-[13px] text-muted underline decoration-line underline-offset-4 transition-colors hover:text-ink hover:decoration-ink"
        href="/"
      >
        ← Back to the directory
      </a>

      <div class="mt-8 font-sans text-[11px] uppercase tracking-[0.2em] text-faint">
        An index · {sortedTags.length} topics
      </div>
      <h1
        class="mt-5 font-display text-4xl font-medium leading-tight tracking-tight text-ink sm:text-5xl"
      >
        Topics
      </h1>
      <p class="mt-4 text-[15px] leading-relaxed text-muted">
        Every entry in the directory, grouped by subject. Pick a topic to see
        what it covers.
      </p>

      <ul class="mt-10 flex flex-wrap gap-2" role="list">
        {
          sortedTags.map(({ displayName, slug, count }) => (
            <li>
              <a
                href={`/tags/${slug}`}
                class="inline-flex items-center gap-2 rounded border border-line bg-paper px-3 py-1.5 font-sans text-[12px] text-muted transition-colors hover:border-faint hover:text-ink"
              >
                <span>#{displayName}</span>
                <span class="tabular text-faint">{count}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="mt-12 border-t border-line pt-6">
        <a
          class="font-sans text-sm text-muted underline decoration-line underline-offset-4 transition-colors hover:text-ink hover:decoration-ink"
          href="/"
        >
          ← Back to all entries
        </a>
      </div>
    </article>
  </main>
</Document>
