---
import { getCollection } from "astro:content";
import { format } from "date-fns";

import { ArticleArtwork } from "~/components/ArticleArtwork";
import Head from "~/components/Head.astro";
import Document from "~/layouts/Document.astro";
import "~/styles/directory.css";

const projects = await getCollection("projects").then((projects) =>
  projects
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
    .map(({ data }) => data),
);

const statusLabels = {
  production: "In production",
  development: "In development",
  maintenance: "Maintained",
  idea: "An idea",
  archived: "Archived",
};
---

<Head
  title="Projects"
  description="Open source projects and developer tools by Ezz Abuzaid. JavaScript, TypeScript, Angular, and Node.js libraries and applications."
/>

<Document>
  <main class="article-directory flex-1" id="main-content" tabindex="-1">
    <header class="collection-intro">
      <p class="collection-kicker">
        A workshop · {projects.length}
        {projects.length === 1 ? "project" : "projects"}
      </p>
      <h1 class="collection-title">Projects</h1>
      <p class="collection-description">
        Things I've built — from ideas on paper to software in production.
      </p>
    </header>

    <div class="directory-content">
      <div class="featured-articles">
        {
          projects.map((project) => {
            const status = statusLabels[project.status || "development"];
            const Component = project.url ? "a" : "div";

            return (
              <article class="article-card">
                <Component
                  href={project.url}
                  target={project.url ? "_blank" : undefined}
                  rel={project.url ? "noopener noreferrer" : undefined}
                  class="project-card-content"
                >
                  <div class="article-artwork">
                    <ArticleArtwork
                      slug={project.title}
                      topic={project.title}
                    />
                  </div>
                  <span class="article-tag">{status}</span>
                  <h2 class="article-title">{project.title}</h2>
                  {project.description && (
                    <p class="article-description">{project.description}</p>
                  )}
                  <div class="project-meta">
                    <span>Ezz Abuzaid</span>
                    <time datetime={format(project.date, "yyyy-MM-dd")}>
                      {format(project.date, "yyyy")}
                    </time>
                  </div>
                  <span class="project-visit">
                    {project.url ? "Visit" : "Unreleased"}
                    {project.url && <span aria-hidden="true"> ↗</span>}
                  </span>
                </Component>
              </article>
            );
          })
        }
      </div>
      {
        projects.length === 0 && (
          <p class="directory-empty collection-description">
            No projects yet. Check back soon.
          </p>
        )
      }
    </div>
  </main>
</Document>
