---
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";

const socialLinks = await getCollection("socialLinks").then((links) =>
  links.sort((a, b) => a.data.name.localeCompare(b.data.name)),
);
const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div class="mx-auto max-w-content px-5 py-10">
    <div
      class="flex flex-col gap-2 font-sans text-xs text-faint sm:flex-row sm:items-center sm:justify-between"
    >
      <span>Written by Ezz Abuzaid.</span>
      <div class="flex items-center gap-3">
        {
          socialLinks.map(({ data: link }, index) => (
            <>
              {index > 0 && <span aria-hidden="true">·</span>}
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 underline decoration-line underline-offset-4 hover:text-ink hover:decoration-ink"
              >
                <Icon class="size-3.5" name={link.icon} />
                {link.name}
              </a>
            </>
          ))
        }
        <span aria-hidden="true">·</span>
        <span>© {year}</span>
      </div>
    </div>
  </div>
</footer>
