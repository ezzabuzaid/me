---
import { getCollection } from "astro:content";
const socialLinks = await getCollection("socialLinks").then((links) =>
  links.sort((a, b) => a.data.name.localeCompare(b.data.name)),
);
const email = socialLinks.find(({ id }) => id === "email")?.data;
const projects = await getCollection("projects").then((projects) =>
  projects.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
);
---

<footer class="site-footer">
  <a href="/" class="footer-wordmark" aria-label="Ezz Abuzaid home"
    ><span aria-hidden="true">›_</span> Ezz Abuzaid</a
  >
  <div class="footer-contact">
    <div class="footer-pattern" aria-hidden="true"></div>
    <a href={email?.url ?? "/projects"} class="footer-cta"
      >{email ? "Say hello" : "Explore projects"}
      <span aria-hidden="true">↗</span></a
    >
    <nav class="footer-projects" aria-label="Projects">
      <ul>
        {
          projects.map(({ data: project }) => (
            <li>
              {project.url ? (
                <a href={project.url}>{project.title}</a>
              ) : (
                project.title
              )}
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="footer-pattern" aria-hidden="true"></div>
  </div>
  <div class="footer-bottom">
    <span>© {new Date().getFullYear()} Ezz Abuzaid</span>
    <nav aria-label="Social links">
      {
        socialLinks.map(({ data: link }) => (
          <a href={link.url}>
            {link.name} <span aria-hidden="true">↗</span>
          </a>
        ))
      }
      <a href="/rss.xml">RSS <span aria-hidden="true">↗</span></a>
    </nav>
    <a href="#top">Back to top ↑</a>
  </div>
</footer>
