---
import type { CollectionEntry } from "astro:content";

import PostRow from "~/components/PostRow.astro";

export interface Props {
	posts: CollectionEntry<"posts">[];
	title?: string;
	class?: string;
}

const { posts, title = "Related entries", class: className } = Astro.props;

if (posts.length === 0) {
	return null;
}
---

<section class:list={["mt-10", className]}>
	<h2 class="font-sans text-xs uppercase tracking-[0.15em] text-faint">
		{title}
	</h2>

	<div class="mt-3 divide-y divide-line border-y border-line">
		{
			posts.map((post) => (
				<PostRow
					href={`/posts/${post.slug}`}
					title={post.data.title}
					year={post.data.publishedAt.getFullYear()}
					kicker={post.data.tags?.[0]}
					description={post.data.description}
				/>
			))
		}
	</div>
</section>
