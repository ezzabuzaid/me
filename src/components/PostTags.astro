---
import { generateTagSlug } from "~/utils/seo";

export interface Props {
	tags: string[];
	class?: string;
}

const { tags, class: className } = Astro.props;

if (!tags || tags.length === 0) {
	return null;
}

const tagsWithSlugs = tags.map((tag) => ({
	name: tag,
	slug: generateTagSlug(tag),
}));
---

<div class:list={["flex flex-wrap gap-2", className]}>
	{
		tagsWithSlugs.map(({ name, slug }) => (
			<a
				href={`/tags/${slug}`}
				class="rounded border border-line px-2 py-0.5 font-sans text-[11px] text-muted transition-colors hover:border-faint hover:text-ink"
			>
				#{name}
			</a>
		))
	}
</div>
