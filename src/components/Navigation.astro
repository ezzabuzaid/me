---
import { getCollection } from "astro:content";

const email = await getCollection("socialLinks").then(
  (links) => links.find(({ id }) => id === "email")?.data,
);
---

<header class="sticky top-0 z-40 border-b border-line bg-canvas/90 backdrop-blur">
  <div class="mx-auto flex max-w-content items-center justify-between px-5 py-3.5">
    <a class="group flex items-baseline gap-2" href="/">
      <span class="font-display text-lg font-medium tracking-tight text-ink">
        Ezz Abuzaid
      </span>
    </a>

    <nav class="flex items-center gap-6 font-sans text-[12px] text-muted">
      <a class="transition-colors hover:text-ink" href="/">Directory</a>
      <a class="hidden transition-colors hover:text-ink sm:inline" href="/projects">
        Projects
      </a>
      <a class="hidden transition-colors hover:text-ink sm:inline" href="/internet">
        Internet
      </a>
      {
        email && (
          <a
            href={email.url}
            class="inline-flex items-center gap-1.5 font-sans text-muted underline decoration-line underline-offset-4 transition-colors hover:text-ink hover:decoration-ink"
          >
            Say hi
            <span aria-hidden="true">→</span>
          </a>
        )
      }
      <button
        type="button"
        data-theme-toggle
        class="transition-colors hover:text-ink"
        aria-label="Toggle color theme"
        title="Toggle color theme"
      >
        <span class="dark:hidden" aria-hidden="true">☾</span>
        <span class="hidden dark:inline" aria-hidden="true">☀</span>
      </button>
    </nav>
  </div>
</header>
