---
import { Menu, Moon, Search, Sun } from "lucide-preact";
const path = Astro.url.pathname;
---

<header class="site-header">
  <a class="site-brand" href="/" aria-label="Ezz Abuzaid home">
    <span class="brand-prompt" aria-hidden="true">›_</span>
    <span>Ezz Abuzaid</span>
  </a>
  <p class="site-tagline">A tinkerer who writes to think.</p>
  <nav class="header-controls" aria-label="Main navigation">
    <a
      class="header-text-link"
      href="/projects"
      aria-current={path.startsWith("/projects") ? "page" : undefined}
      >Projects</a
    >
    <a
      class="header-text-link"
      href="/internet"
      aria-current={path.startsWith("/internet") ? "page" : undefined}
      >Internet</a
    >
    <a class="header-icon" href="/#article-search" aria-label="Search articles"
      ><Search size={20} strokeWidth={1.5} aria-hidden="true" /></a
    >
    <button
      type="button"
      data-theme-toggle
      class="header-icon"
      aria-label="Switch to dark mode"
      aria-pressed="false"
      title="Toggle color theme"
    >
      <Sun class="dark:hidden" size={21} strokeWidth={1.5} aria-hidden="true" />
      <Moon
        class="hidden dark:inline"
        size={20}
        strokeWidth={1.5}
        aria-hidden="true"
      />
    </button>
    <details class="mobile-navigation">
      <summary class="header-icon" aria-label="Navigation menu">
        <Menu size={20} strokeWidth={1.5} aria-hidden="true" />
      </summary>
      <div class="mobile-navigation-links">
        <a href="/" aria-current={path === "/" ? "page" : undefined}>Writing</a>
        <a
          href="/projects"
          aria-current={path.startsWith("/projects") ? "page" : undefined}
          >Projects</a
        >
        <a
          href="/internet"
          aria-current={path.startsWith("/internet") ? "page" : undefined}
          >Internet</a
        >
        <a href="/rss.xml">RSS feed ↗</a>
      </div>
    </details>
  </nav>
</header>
